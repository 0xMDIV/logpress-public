# Supabase — required for auth, database, and Edge Functions
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-jwt

# Firebase Analytics — optional, app works without it
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
# VITE_FIREBASE_MEASUREMENT_ID=

# Requesty / AI — set these as Supabase Edge Function secrets, NOT in .env:
#   supabase secrets set REQUESTY_API_KEY=sk-your-key
#   supabase secrets set REQUESTY_BASE_URL=https://router.requesty.ai/v1
#   supabase secrets set REQUESTY_MODEL=gpt-4o-mini
