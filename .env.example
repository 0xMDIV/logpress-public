# ──────────────────────────────────────────────
# LogPress — single .env for both RN app & Vite PWA
# Copy this file to .env and fill in your values.
# ──────────────────────────────────────────────

# ── Supabase (required for both RN and Vite) ──
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-jwt
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-jwt

# ── AI / Requesty (Edge Function secrets, NOT in .env) ──
#   supabase secrets set REQUESTY_API_KEY=sk-your-key
#   supabase secrets set REQUESTY_BASE_URL=https://router.requesty.ai/v1
#   supabase secrets set REQUESTY_MODEL=gpt-4o-mini

# ── Legacy (React Native only, can ignore for PWA) ──
OPENAI_API_KEY=sk-your-openai-key-here
ADAPTY_API_KEY=public_live_your_adapty_key
