# ──────────────────────────────────────────────
# LogPress — single .env for both RN app & Vite PWA
# Copy this file to .env and fill in your values.
# ──────────────────────────────────────────────

# ── Supabase (required for both RN and Vite) ──
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-jwt
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-jwt

# ── AI / Requesty (Edge Function, set as Supabase secret, NOT in .env) ──
#   supabase secrets set REQUESTY_API_KEY=sk-your-key
#   supabase secrets set REQUESTY_BASE_URL=https://router.requesty.ai/v1
#   supabase secrets set REQUESTY_MODEL=gpt-4o-mini

# ── Firebase Analytics (optional — Vite only, app works without it) ──
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
# VITE_FIREBASE_MEASUREMENT_ID=

# ── Legacy (React Native only, can ignore for PWA) ──
OPENAI_API_KEY=sk-your-openai-key-here
ADAPTY_API_KEY=public_live_your_adapty_key
